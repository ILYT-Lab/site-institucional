---
// Layout de todas as páginas: <head> com SEO, fontes, ícones, dados estruturados e medição.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import unboundedWoff2 from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import onestWoff2 from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Fab from '../components/ui/Fab.astro';
import Analytics from '../components/ui/Analytics.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string; // imagem de compartilhamento (1200×630), caminho em /public
  schema?: object[]; // dados estruturados (JSON-LD)
  noindex?: boolean;
  home?: boolean; // na home, os links do menu rolam até as seções
}

const { title, description, image = '/og.jpg', schema = [], noindex = false, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, '') || site.url;
const ogImage = new URL(image, site.url).href;
const blockIndex = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={unboundedWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={onestWoff2} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ILYT: sites, sistemas e aplicativos sob medida" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : { '@context': 'https://schema.org', '@graph': schema })} />}
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header home={home} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer home={home} />
    <Fab />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
