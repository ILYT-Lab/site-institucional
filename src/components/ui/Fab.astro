---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '../../config/site';
---
<a class="fab off" id="fab" href={whatsappUrl()} target="_blank" rel="noopener" data-cta="botao-flutuante" aria-label="Falar com a ILYT no WhatsApp"><WhatsAppIcon /></a>

<style is:global>
  /* botão do WhatsApp: aparece depois da primeira tela; um anel âmbar pulsa e some */
  .fab { position: fixed; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 40; display: grid; place-items: center; width: 56px; height: 56px; background: var(--amber); color: var(--on-amber); border-radius: 50%; box-shadow: var(--shadow-piece); isolation: isolate; transition: transform .32s cubic-bezier(.2, .9, .2, 1.15), opacity .2s; }
  .fab svg { width: 28px; height: 28px; }
  .fab::before { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--amber); z-index: -1; animation: fab-pulse 3s ease-out infinite; }
  @keyframes fab-pulse { 0% { transform: scale(1); opacity: .45; } 60%, 100% { transform: scale(1.6); opacity: 0; } }
  .fab.off { opacity: 0; transform: translateY(12px); pointer-events: none; }
</style>
