---
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../../config/site';

interface Props { home?: boolean }
const base = Astro.props.home ? '' : '/';
const links = [
  { href: '#como-funciona', label: 'Como funciona' },
  { href: '#solucoes', label: 'Soluções' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#duvidas', label: 'Dúvidas' },
];
const social = [
  { url: site.social.instagram, label: 'Instagram', d: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.7 21.31.27 16.95.07 15.67.01 15.26 0 12 0m0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88' },
  { url: site.social.linkedin, label: 'LinkedIn', d: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z' },
].filter((s) => s.url);
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="foot-logo" href={base || '#conteudo'} aria-label="ILYT, página inicial"><Logo /></a>
        <p>{site.tagline}</p>
        <p class="where">{site.city}, {site.region} · atendimento em todo o Brasil</p>
      </div>
      <nav aria-label="Rodapé">
        <p class="ft-h">Navegue</p>
        <ul>{links.map((l) => <li><a href={base + l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <p class="ft-h">Fale com a ILYT</p>
        <ul>
          <li><a href={whatsappUrl()} target="_blank" rel="noopener" data-cta="rodape">WhatsApp {site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        {social.length > 0 && (
          <>
            <p class="ft-h follow">Acompanhe</p>
            <div class="social">
              {social.map((s) => <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={s.d} /></svg></a>)}
            </div>
          </>
        )}
      </div>
    </div>
    <div class="base">
      <span>© {year} {site.name}.{site.cnpj && ` CNPJ ${site.cnpj}`}</span>
      <span>
        <a href="/politica-de-privacidade">Política de privacidade</a>
        {site.analytics.gtmId && <> · <button type="button" class="linkish" data-consent-open>Preferências de cookies</button></>}
      </span>
    </div>
  </div>
</footer>

<style is:global>
  footer { padding-block: 64px 40px; border-top: 1px solid var(--line); }
  .foot { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr) minmax(0, 1fr); gap: 32px; }
  .foot-logo { display: block; width: min(100%, 380px); color: #fff; }
  .foot-logo svg { display: block; width: 100%; height: auto; overflow: visible; }
  .foot p { margin: 18px 0 0; color: var(--ink-muted); max-width: 34ch; }
  .foot .where { margin-top: 6px; font-size: var(--fs-small); }
  .foot .ft-h { margin: 0 0 14px; font: 500 var(--fs-label)/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .foot .ft-h.follow { margin-top: 28px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .social { display: flex; gap: 18px; }
  .social a { color: var(--ink-muted); transition: color .16s; }
  .social a:hover { color: var(--ink); }
  .social svg { width: 22px; height: 22px; display: block; }
  .foot a, .base a { text-decoration: none; }
  .foot a:hover, .base a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--ink-muted); }
  .linkish { all: unset; cursor: pointer; }
  .linkish:hover { text-decoration: underline; text-underline-offset: 4px; }
  .linkish:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }

  @media (max-width: 1000px) {
    .foot { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .foot > :first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .foot > :first-child { text-align: center; }
    .foot > :first-child .foot-logo, .foot > :first-child p { margin-inline: auto; }
    .base { flex-direction: column; align-items: center; text-align: center; }
  }
</style>
