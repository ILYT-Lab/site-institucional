---
import { faq } from '../../content/faq';
---
<section class="band flush" id="duvidas">
  <div class="wrap faq-grid">
    <header><p class="eyebrow">Perguntas frequentes</p><h2>O que todo mundo pergunta <span class="thin">antes de começar.</span></h2></header>
    <div class="faq">
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary><h3>{f.q}</h3><span class="pm" aria-hidden="true">+</span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .faq-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 64px; align-items: start; }
  .faq-grid header { display: grid; gap: 22px; position: sticky; top: 120px; }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; padding: 24px 0; display: flex; justify-content: space-between; gap: 24px; }
  .faq summary h3 { font: 500 19px/1.35 var(--font-sans); text-wrap: pretty; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq .pm { font: 400 22px/1 var(--font-mono); color: var(--ink-muted); transition: transform .32s cubic-bezier(.16, 1, .3, 1); flex: none; }
  .faq details[open] .pm { transform: rotate(45deg); color: var(--amber); }
  .faq details p { margin: 0; padding: 0 48px 24px 0; color: var(--ink-muted); max-width: 60ch; }

  @media (max-width: 1000px) {
    .faq-grid { grid-template-columns: minmax(0, 1fr); }
    .faq-grid header { position: static; }
  }
  @media (max-width: 600px) {
    .faq details p { padding-right: 0; }
  }
</style>
